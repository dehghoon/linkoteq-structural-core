{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkoteq.example/schemas/compatibility.schema.json",
  "type": "object",
  "required": [
    "id",
    "subjectRef",
    "objectRef",
    "relationship",
    "sourceRefs",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "subjectRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "objectRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "relationship": {
      "enum": [
        "compatible",
        "incompatible",
        "conditional"
      ]
    },
    "conditions": {
      "type": "object"
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "discovered",
            "reviewed",
            "validated",
            "verified",
            "blocked"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
